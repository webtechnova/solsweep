# Copy to .env.local for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables.
#
# NOTE: NEXT_PUBLIC_* values are embedded in the browser bundle, so they are PUBLIC.
# Never put a secret here. If your RPC provider issues API keys, restrict the key
# to your site's domain in the provider dashboard.

# "mainnet-beta" (real SOL) or "devnet" (test SOL).
# Production builds also read .env.production, which is set to mainnet-beta.
# For local devnet testing, put NEXT_PUBLIC_SOLANA_NETWORK=devnet in .env.local.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Optional custom RPC endpoint (Helius, QuickNode, Alchemy, Triton...).
# Leave empty to use the built-in endpoint: PublicNode on mainnet, the public
# devnet URL otherwise. Do not set this to https://api.mainnet-beta.solana.com —
# that endpoint returns 403 Access forbidden to browser apps.
NEXT_PUBLIC_RPC_URL=
